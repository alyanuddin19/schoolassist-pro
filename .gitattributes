# Normalize line endings across Windows/Linux/Mac team members and CI.
* text=auto

# Shell scripts must stay LF (Render/Linux build + GitHub Actions)
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows-only files keep CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binaries
*.png binary
*.jpg binary
*.ico binary
*.docx binary
*.xlsx binary
*.pdf binary
