# ============================================================
# SchoolAssist Backend - Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file and NEVER expose these keys
# to the Angular frontend. All secrets stay on the backend only.
# ============================================================

# --- Database (Supabase PostgreSQL) ---
# For instant local development: leave DATABASE_URL empty/omitted and the
# backend uses a local SQLite file (schoolassist.db) automatically.
# For production, get the connection string from
# Supabase -> Project Settings -> Database -> Connection string (URI),
# use the session pooler (port 5432), replace the password, and keep the
# scheme as postgresql:// (not postgres://):
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# --- JWT Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-this-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AI provider: Groq (free tier, no credit card needed) ---
# GET YOUR KEY: https://console.groq.com/keys (starts with gsk_)
DASHSCOPE_API_KEY=your_groq_api_key
QWEN_BASE_URL=https://api.groq.com/openai/v1
QWEN_MODEL=qwen/qwen3.8-27b

# --- Alternative AI provider: Alibaba Model Studio / Qwen ---
# DASHSCOPE_API_KEY=sk-your-alibaba-key
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-plus

# --- CORS ---
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:4200
